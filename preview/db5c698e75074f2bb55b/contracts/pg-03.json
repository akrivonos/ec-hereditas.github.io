  "route": "/tasks/{id}",
  "roles": "Виконавець і уповноважений координатор",
  "workflows": [],
  "phase": "M1",
  "tables": [
    "work_item",
    "work_item_event",
    "work_item_target"
  ],
  "fields_and_relations": "Ціль і її версія, відповідальний, історія переходів, resolution.",
  "required_interaction": "Взяти/повернути/завершити → нова подія; конфлікт версій і відсутність дозволу.",
  "fixtures": [
    "FX-01"
  ],
  "states": [
    "populated",
    "empty",
    "loading",
    "error",
    "forbidden"
  ],
  "maturity": "implemented",
  "source": "docs/lnu/Е_План_макетів_сторінок.md#8",
  "implementation": {
    "view_model": "taskView(actor, id) with exact target revisions/events/dependencies",
    "commands": [
      "task.transition",
      "task.assign"
    ],
    "fields": [
      {
        "field": "work_item.state",
        "mode": "command-only",
        "values": [
          "open",
          "assigned",
          "in_progress",
          "blocked",
          "done",
          "cancelled"
        ]
      },
      {
        "field": "work_item.assigned_account_id",
        "mode": "picker",
        "target": "account with active task.work grant"
      },
      {
        "field": "work_item.resolution",
        "mode": "editable-on-complete",
        "required": true
      },
      {
        "field": "work_item_target.revision_id",
        "mode": "readonly",
        "pair": "entity_id / revision_id"
      }
    ],
    "permissions": [
      "task.read",
      "task.work",
      "task.assign"
    ],
    "checks": [
      "optimistic current_revision_id",
      "blocked dependencies",
      "new revision + event atomically",
      "exact target unchanged"
    ],
    "input": {
      "actor": "account.id",
      "scope": "archive.id or all accessible",
      "clock": "fixture UTC time",
      "entity_id": "URL id where applicable"
    },
    "state_storage": "Normalized store in localStorage; single administrator and scope in sessionStorage",
    "atomicity": "clone -> authorize -> validate -> append revision/event -> persist; failures keep state unchanged",
    "common_states": [
      "populated",
      "empty",
      "loading",
      "error",
      "forbidden",
      "stale where editable"
    ]
  }
}
